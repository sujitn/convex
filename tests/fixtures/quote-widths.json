{
  "schema_version": 1,
  "fixture_id": "quote-widths-v1",
  "reference": "Hand-computed desk two-way quotes: a width is the bid-to-ask distance in the level's quoting unit, each side half of it from the mid; a price falls to its bid, a yield or spread rises to it. Not a market convention certificate.",
  "units": {
    "mid": "a trader mark, as convex_core::types::Mark parses it",
    "face": "face amount of the trade, in currency units; null for a quote with no size",
    "price_points": "price per 100 face",
    "thirty_seconds": "32nds of a price point",
    "basis_points": "basis points of yield (0.0001 of a decimal yield) or of spread",
    "bid_ask": "price per 100 face, decimal yield, or basis points of spread, as the mid"
  },
  "tolerance": "exact",
  "certified": false,
  "cases": [
    {
      "id": "treasury-in-32nds-round-lot",
      "note": "99-16+ one 32nd wide at 5mm: 99-16 / 99-17",
      "mid": "99-16+",
      "schedule": {
        "unit": "thirty_seconds",
        "buckets": [
          {
            "max_face": "10000000",
            "width": "1"
          },
          {
            "max_face": "50000000",
            "width": "2"
          },
          {
            "width": "4"
          }
        ]
      },
      "face": "5000000",
      "expected": {
        "width": "1",
        "bid": "99.5",
        "ask": "99.53125"
      }
    },
