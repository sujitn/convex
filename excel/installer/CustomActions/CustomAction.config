<?xml version="1.0" encoding="utf-8"?>
<!-- Read by WiX's SfxCA host from inside InstallerActions.CA.dll. Without it the host
     binds the newest CLR it finds by the old rules, which is 2.0 wherever .NET 3.5 is
     installed, and then cannot load this net472 assembly. -->
<configuration>
  <startup useLegacyV2RuntimeActivationPolicy="true">
    <supportedRuntime version="v4.0" />
  </startup>
</configuration>
