<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>11.0</LangVersion>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>Convex.Excel</AssemblyName>
    <RootNamespace>Convex.Excel</RootNamespace>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <PropertyGroup>
    <!-- The add-in's version is the workspace's, so CX.DIAG and the release agree.
         The release workflow checks the tag against the same line. -->
    <Version>$([System.Text.RegularExpressions.Regex]::Match($([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)..\..\Cargo.toml')), '(?m)^version\s*=\s*&quot;([^&quot;]+)&quot;').Groups[1].Value)</Version>
  </PropertyGroup>

  <PropertyGroup>
    <!-- x64 only: convex_ffi.dll is a 64-bit library. -->
    <ExcelDnaCreate32BitAddIn>false</ExcelDnaCreate32BitAddIn>
    <!-- Built with the `excel` cargo profile; see [profile.excel] in Cargo.toml.
         Override with -p:NativeLibPath=... when cargo builds elsewhere. -->
    <NativeLibPath Condition="'$(NativeLibPath)' == ''">..\..\target\excel\convex_ffi.dll</NativeLibPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ExcelDna.AddIn" Version="1.9.0" />
    <PackageReference Include="ExcelDna.Integration" Version="1.9.0" />
    <PackageReference Include="ExcelDna.IntelliSense" Version="1.9.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Windows.Forms.DataVisualization" />
    <Reference Include="Microsoft.CSharp" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Net.Http" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Convex.Excel.dna">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>Convex.Excel.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <!-- Copy native library next to both the loose and the packed .xll.
       convex_ffi.dll ships side by side: packing it into the .xll fails at
       load on Excel-DNA 1.9 / net472 (measured in X0), so NativeLoader binds
       it by absolute path at AutoOpen. -->
  <Target Name="CopyNativeLib" AfterTargets="Build" Condition="Exists('$(NativeLibPath)')">
    <Copy SourceFiles="$(NativeLibPath)" DestinationFolder="$(OutputPath)" />
    <Copy SourceFiles="$(NativeLibPath)" DestinationFolder="$(OutputPath)publish" />
  </Target>
</Project>
